generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Teams {
  id     String @id
  name   String
  abbr   String
  market String
}

model Credentials {
  id       String @id
  email    String
  password String

  @@unique([email,password])
  @@unique([email])
}
